# Ignore everything by default
*

# Application packages and their contents
!main.py
!io_manager/
!io_manager/**
!data_manager/
!data_manager/**
!logic_manager/
!logic_manager/**
!ai_module/
!ai_module/**

# Test Script
!tests/
!tests/**

# Main dependencies
!requirements.txt

# Docker configuration
!Dockerfile
!.dockerignore

# Keep local credentials, caches and generated results out of all packages.
**/*.env
**/.env*
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.venv/
**/venv/
**/.recipes-*.tmp
**/recipes.json
**/recipe_results.csv
**/rejected.txt
